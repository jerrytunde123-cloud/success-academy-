{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "globals": {
        "PaystackPop": "readonly"
    },
    "rules": {
        "eqeqeq": ["error", "always"],
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-console": "off",
        "no-alert": "off",
        "curly": "error",
        "strict": ["error", "safe"],
        "no-undef": "error",
        "no-eval": "error",
        "no-implied-eval": "error",
        "no-lone-blocks": "error",
        "no-multi-spaces": "error",
        "no-tabs": "warn",
        "semi": ["error", "always"],
        "quotes": ["error", "single", { "avoidEscape": true }]
    },
    "ignorePatterns": [
        "node_modules/",
        "assets/",
        ".vercel/"
    ]
}
