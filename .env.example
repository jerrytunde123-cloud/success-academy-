# ============================================================
# SUCCESS ACADEMY — Environment Variables
# Add these in Vercel → Project → Settings → Environment Variables.
# For local development, copy this file to .env.
# ============================================================

# ── Turso (database) ───────────────────────────────────────
# Turso dashboard → your database → Connect / Settings.
# The URL normally starts with libsql://
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Admin session ──────────────────────────────────────────
# Password used on /admin. Choose a strong password.
ADMIN_PASSWORD=change-me
# Random secret used to sign the HttpOnly admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Paystack (payments) ────────────────────────────────────
# Secret key. It is used server-side and never sent to the browser.
# The frontend uses Paystack's hosted checkout via an authorization URL.
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
# Public key. Safe to expose; returned by GET /api/config.
# If omitted, the built-in key in lib/paystack.js is used as a fallback.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Paystack's return URL is built automatically from the request host
# on Vercel. Set this only if you use a custom domain or want to force one.
# Example: https://success-academy.vercel.app
# PUBLIC_BASE_URL=https://your-project.vercel.app

# ── Cloudflare R2 (image storage) ──────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public bucket URL (r2.dev subdomain or a custom domain).
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Optional: EmailJS email for replies and result PIN receipts ───────────
# One template is reused everywhere. The browser sends {{to_email}} and
# {{{html}}} (triple braces render the browser-built HTML body).
# No private key is used. These public identifiers are env-driven, never
# hardcoded; result buyers receive them from GET /api/result-pins/emailjs.
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxx
