# ============================================================
# SUCCESS ACADEMY — Environment Variables
# ============================================================
# Copy this file to .env (local) or add these to Vercel
# Project Settings → Environment Variables
# ============================================================

# ── Database (Turso) ────────────────────────────────────────
# Get these from https://turso.tech → your database → Settings
TURSO_DATABASE_URL=https://your-database-name.turso.io
TURSO_AUTH_TOKEN=eyJ...your-turso-auth-token...

# ── Image Storage (Cloudflare R2) ───────────────────────────
# Get these from Cloudflare Dashboard → R2 → your bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-r2-url.r2.dev

# ── App ─────────────────────────────────────────────────────
# Your deployed Vercel domain (e.g. https://success-academy.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Admin dashboard password — set anything you want
ADMIN_PASSWORD=your-secure-admin-password

# ============================================================
# Notes:
# - Do NOT commit .env to GitHub (it's in .gitignore)
# - Paystack secret key is NOT here — it stays server-side in api/pins.js
# - Only the Paystack PUBLIC key is in frontend script.js (safe to expose)
# ============================================================
